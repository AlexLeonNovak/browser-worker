PORT=3001

# Captcha solver defaults — used when /execute does not pass `captchaSolver` in body.
# CAPTCHA_PROVIDER: "2captcha", "capsolver", or "flaresolverr"  (default: "2captcha")
# Provide only the key(s) you intend to use.
CAPTCHA_PROVIDER=2captcha
CAPTCHA_API_KEY_2CAPTCHA=
CAPTCHA_API_KEY_CAPSOLVER=

# FlareSolverr (self-hosted, free Cloudflare bypass). Used by the "flaresolverr"
# provider and as a fallback inside the auto-strategy for cloudflare-challenge.
# Defaults to the sibling service in docker-compose.
FLARESOLVERR_URL=http://flaresolverr:8191
