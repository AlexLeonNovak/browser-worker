PORT=3001

# Shared secret for the API. Sent as `x-worker-token: <token>` or
# `Authorization: Bearer <token>`. GET /health stays open so container
# healthchecks work.
# LEAVE THIS BLANK ONLY ON A LAPTOP: /execute runs arbitrary JS and arbitrary
# fetch inside the browser, with its cookie jar and its proxy. The server logs a
# warning banner at boot when it is unset.
WORKER_TOKEN=

# Max concurrent sessions (browser contexts). Over the cap, /execute returns 429.
# Reusing an existing sessionId is never capped.
MAX_SESSIONS=5

# How long a pooled browser with no sessions stays alive before it is closed.
# Sessions sharing a launch config (headless + disableSecurity + proxy) share one
# browser, so a sequential run of many logins pays for one launch, not N.
BROWSER_IDLE_MS=60000

# How long SIGTERM waits for in-flight steps before tearing sessions down.
# Keep the container's stop_grace_period above this.
SHUTDOWN_GRACE_MS=15000

# Container resource limits (docker-compose). The defaults in docker-compose.yml
# assume a roomy host; a 4 GB box wants MEM_LIMIT=3g and SHM_SIZE=1gb.
MEM_LIMIT=
SHM_SIZE=

# Default proxy applied to every session when /execute body omits `proxy`.
# Pass `"proxy": null` in the request body to opt out for that one request,
# or `"proxy": { "server": "...", ... }` to override per request.
# Leave blank to run without a default proxy.
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_BYPASS=

# Captcha solver — fill the keys for every provider you want available.
# CAPTCHA_PROVIDER is just the default when /execute body has no captchaSolver.provider.
# To use a different provider on a per-request basis, pass
# { captchaSolver: { provider: "..." } } in the body — the matching api key is
# picked from env automatically. Allowed providers: 2captcha, capsolver,
# anti-captcha, flaresolverr.
CAPTCHA_PROVIDER=2captcha
CAPTCHA_API_KEY_2CAPTCHA=
CAPTCHA_API_KEY_CAPSOLVER=
CAPTCHA_API_KEY_ANTI_CAPTCHA=

# FlareSolverr (self-hosted, free Cloudflare bypass). Used by the "flaresolverr"
# provider and as a fallback inside the auto-strategy for cloudflare-challenge.
# Defaults to the sibling service in docker-compose.
FLARESOLVERR_URL=http://flaresolverr:8191
